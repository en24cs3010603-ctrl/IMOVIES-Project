# 🎬 IMovies - Backend Server Environment Configuration (server/.env.example)

# Port for the Express REST API
PORT=5000

# MongoDB Atlas Connection String
# Replace with your actual credentials: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://admin:StrongPassword123@cluster0.mongodb.net/imovies?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a strong random 256-bit string in production)
JWT_SECRET=imovies_super_secure_production_secret_token_key_2026

# JWT Expiration Duration (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:3000

# Environment Mode: development | production
NODE_ENV=development
